[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[user]
	name = Nicholas Dille
[init]
	defaultBranch = main
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[checkout]
        defaultRemote = origin

[credential "https://codeberg.org"]
	helper = cache --timeout 7200
	helper = oauth
	uthClientId = a4792ccc-144e-407e-86c9-5e7d8d9c3269
	uthAuthURL = /login/oauth/authorize
	uthTokenURL = /login/oauth/access_token
[credential "https://gitlab.com"]
	helper = 
	helper = !/home/nicholas/.local/bin/glab auth git-credential
[credential "https://github.com"]
	helper = 
	helper = !/home/nicholas/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/nicholas/.local/bin/gh auth git-credential

[include]
    path = ~/haufe/gitconfig

[includeIf "gitdir:~/private/"]
    path = ~/private/gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/nicholasdille/dotfiles"]
    path = ~/private/gitconfig
[includeIf "gitdir:~/.passage/"]
    path = ~/private/gitconfig

[alias]
    lg  = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit"
    lgg = "log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all"
