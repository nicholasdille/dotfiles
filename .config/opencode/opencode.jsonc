{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": {},
  "mcp": {
    "gitlab": {
      "type": "local",
      "command": [
        "glab",
        "mcp",
        "serve"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "k8s": {
      "type": "local",
      "command": [
        "kubernetes-mcp-server",
        "--read-only"
      ],
      "enabled": true
    }
  }
}
