{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "lsp": {},
  "mcp": {
    "gitlab": {
      "type": "remote",
      "url": "https://gitlab.com/api/v4/mcp"
    },
    "github": {
      "type": "local",
      "command": [
        "github-mcp-server",
        "stdio"
      ],
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "k8s": {
      "type": "local",
      "command": [
        "kubernetes-mcp-server",
        "--config=$HOME/.config/kubernetes-mcp-server/config.toml"
      ],
      "enabled": true
    },
    "scw": {
      "type": "local",
      "command": [
        "scw",
        "mcp",
        "server",
        "serve",
        "read-only=true"
      ],
      "enabled": true
    }
  }
}
